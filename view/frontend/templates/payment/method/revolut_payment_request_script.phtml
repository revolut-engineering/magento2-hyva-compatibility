<?php
declare(strict_types=1);
/** @var \Revolut\PaymentHyva\Block\Checkout\Payment\RevolutScript $block */
/** @var array<string,string> $walletConfig */
$methodCode = $walletConfig['methodCode'];
$preferredPaymentMethod = $walletConfig['preferredPaymentMethod'];
$targetId = $walletConfig['targetId'];
$magewireComponentName = $walletConfig['magewireComponentName'];
$buttonStyleConfigKey = $walletConfig['buttonStyleConfigKey'];
$errorEventName = $walletConfig['errorEventName'];
$methodDisplayName = $walletConfig['methodDisplayName'];
?>
    (() => {
        hyvaCheckout.api.after(() => {
            const revolutConfig = <?= $block->getRevolutConfig() ?>;
            const cascadingStepRoutes = <?= $block->getCascadingStepRoutes() ?>;
            const quoteCurrency = <?= /* @noEscape */ json_encode($block->getQuoteCurrencyCode()) ?>;
            const quoteAmount = <?= (float) $block->getGrandTotal() ?>;
            const methodCode = '<?= /* @noEscape */ $methodCode ?>';
            const preferredPaymentMethod = '<?= /* @noEscape */ $preferredPaymentMethod ?>';
            const targetId = '<?= /* @noEscape */ $targetId ?>';
            const magewireComponentName = '<?= /* @noEscape */ $magewireComponentName ?>';
            const buttonStyleConfigKey = '<?= /* @noEscape */ $buttonStyleConfigKey ?>';
            const errorEventName = '<?= /* @noEscape */ $errorEventName ?>';
            const methodDisplayName = '<?= /* @noEscape */ $methodDisplayName ?>';
            let paymentRequestInstance = null;
            let paymentRequestTarget = null;
            let capabilityPromise = null;
            let isAvailable = null;

            const getWireComponent = () => {
                return Magewire.find(magewireComponentName);
            };

            // Hyvä's validate() does not enforce the billing city, which the backend place-order requires.
            const ensureBillingComplete = async () => {
                const wire = getWireComponent();
                if (!wire) return false;

                await wire.call('syncQuoteData');
                const billing = wire.get('billingAddress');
                const email = wire.get('email');

                if (!email || !billing) {
                    hyvaCheckout.payment.dispatchExceptionMessage('Please provide your billing and email address.', 'error');
                    return false;
                }
                if (!billing.city) {
                    hyvaCheckout.payment.dispatchExceptionMessage('Please provide a city for your billing address.', 'error');
                    return false;
                }
                return true;
            };

            // The wallet places the order from the payment step, so any later step (e.g. the mobile
            // "summary") is never visited. Mark every step route complete so the server cascade gate
            // (Main::validateCascadingStepData) accepts the order.
            const markAllStepsComplete = () => {
                if (!Array.isArray(cascadingStepRoutes)) return;
                cascadingStepRoutes.forEach((route) => {
                    hyvaCheckout.storage.setValue(route, true, 'cascading-step-data');
                });
            };

            const loadSdk = () => {
                if (window.RevolutCheckout) {
                    return Promise.resolve(window.RevolutCheckout);
                }
                if (window.revolutCheckoutSdkPromise) {
                    return window.revolutCheckoutSdkPromise;
                }

                window.revolutCheckoutSdkPromise = new Promise((resolve) => {
                    if (!revolutConfig || !revolutConfig.revolutSdk) {
                        resolve(null);
                        return;
                    }

                    const script = document.createElement('script');
                    script.id = 'revolut-checkout-sdk';
                    script.src = revolutConfig.revolutSdk;
                    script.onload = () => resolve(window.RevolutCheckout || null);
                    script.onerror = () => resolve(null);
                    document.head.appendChild(script);
                });

                return window.revolutCheckoutSdkPromise;
            };

            const getMinorAmount = (amount, currency) => {
                const options = { style: 'currency', currency };
                const numberFormat = new Intl.NumberFormat('en-GB', options);
                const parts = numberFormat.formatToParts(amount);
                const fractionPart = parts.find(part => part.type === 'fraction');
                const fractionalLength = fractionPart ? fractionPart.value.length : 0;
                const minorUnitFactor = Math.pow(10, fractionalLength);

                return Math.round(amount * minorUnitFactor);
            };

            const showLoader = () => window.dispatchEvent(new Event('magewire:loader:start'));
            const hideLoader = () => window.dispatchEvent(new Event('magewire:loader:done'));

            const hidePlaceOrderButton = () => {
                hyvaCheckout.navigation.disableButtonPlaceOrder();
                const navMain = document.querySelector('.checkout-nav-main');
                if (navMain) navMain.style.display = 'none';
            };

            const showPlaceOrderButton = () => {
                hyvaCheckout.navigation.enableButtonPlaceOrder();
                const navMain = document.querySelector('.checkout-nav-main');
                if (navMain) navMain.style.display = '';
            };

            const validateCheckout = async () => {
                return await hyvaCheckout.validation.validate() && await ensureBillingComplete();
            };

            const selectFallbackMethod = () => {
                const selected = document.getElementById(`payment-method-${methodCode}`);
                if (!selected || !selected.checked || !window.Magewire) return;

                const fallback = Array.from(document.querySelectorAll(
                    '#payment-method-list input[name="payment-method-option"]'
                )).find((radio) => {
                    const option = radio.closest('[id^="payment-method-option-"]');
                    return radio.value !== methodCode && option && !option.hidden;
                });

                if (fallback) {
                    Magewire.find('checkout.payment.methods').set('method', fallback.value);
                }
            };

            const applyAvailability = () => {
                const option = document.getElementById(`payment-method-option-${methodCode}`);
                if (!option) return;

                option.hidden = isAvailable !== true;
                if (isAvailable === false) {
                    selectFallbackMethod();
                }
            };

            const checkCapability = () => {
                if (capabilityPromise) return capabilityPromise;

                capabilityPromise = (async () => {
                    applyAvailability();

                    if (!quoteCurrency || !quoteAmount) {
                        isAvailable = false;
                        applyAvailability();
                        return false;
                    }

                    const request = await createPaymentRequest();
                    if (!request) {
                        isAvailable = false;
                        applyAvailability();
                        return false;
                    }

                    try {
                        isAvailable = await request.canMakePayment() === preferredPaymentMethod;
                    } catch (error) {
                        isAvailable = false;
                    }

                    if (!isAvailable && paymentRequestInstance === request) {
                        request.destroy();
                        paymentRequestTarget.remove();
                        paymentRequestInstance = null;
                        paymentRequestTarget = null;
                    }

                    applyAvailability();
                    return isAvailable;
                })();

                return capabilityPromise;
            };

            const recoverFromOrderPlacementFailure = async (error) => {
                const wire = getWireComponent();
                if (!wire) {
                    throw new Error(methodDisplayName + ' Magewire component is unavailable.');
                }

                const message = error && error.message
                    ? error.message
                    : 'Something went wrong while processing your order.';

                await wire.call('cancelRevolutOrder', message);
                showPlaceOrderButton();
                resetPaymentRequest();
                await renderPaymentRequest();
            };

            const getPaymentRequestData = () => {
                const target = document.getElementById(targetId);
                if (!target) return null;

                const container = target.parentElement;
                const currency = container.getAttribute('data-revolut-currency');
                const amount = getMinorAmount(parseFloat(container.getAttribute('data-revolut-amount')), currency);

                return { target, currency, amount };
            };

            const resetPaymentRequest = () => {
                if (paymentRequestInstance) paymentRequestInstance.destroy();
                if (paymentRequestTarget) paymentRequestTarget.remove();

                paymentRequestInstance = null;
                paymentRequestTarget = null;
                capabilityPromise = null;
                isAvailable = null;
            };

            const attachPaymentRequestTarget = () => {
                const paymentRequestData = getPaymentRequestData();
                if (!paymentRequestTarget || !paymentRequestData) return false;

                paymentRequestTarget.removeAttribute('style');
                paymentRequestData.target.appendChild(paymentRequestTarget);
                return true;
            };

            const hidePaymentRequestTarget = () => {
                if (!paymentRequestTarget) return;

                paymentRequestTarget.style.position = 'absolute';
                paymentRequestTarget.style.left = '-9999px';
                paymentRequestTarget.style.width = '1px';
                paymentRequestTarget.style.height = '1px';
                paymentRequestTarget.style.overflow = 'hidden';
                paymentRequestTarget.style.pointerEvents = 'none';
                document.body.appendChild(paymentRequestTarget);
            };

            const createPaymentRequest = async () => {
                if (paymentRequestInstance) return paymentRequestInstance;

                const RevolutCheckout = await loadSdk();
                if (!RevolutCheckout) return null;
                if (paymentRequestInstance) return paymentRequestInstance;

                const paymentRequestData = getPaymentRequestData();
                const currency = paymentRequestData ? paymentRequestData.currency : quoteCurrency;
                const amount = paymentRequestData
                    ? paymentRequestData.amount
                    : getMinorAmount(quoteAmount, quoteCurrency);

                paymentRequestTarget = document.createElement('div');
                hidePaymentRequestTarget();

                const { paymentRequest } = RevolutCheckout.payments({
                    locale: revolutConfig.locale,
                    publicToken: revolutConfig.publicKey,
                });

                const buttonStyle = revolutConfig[buttonStyleConfigKey] || {};

                const request = paymentRequest.mount(paymentRequestTarget, {
                    currency: currency,
                    amount: amount,
                    requestShipping: false,
                    preferredPaymentMethod: preferredPaymentMethod,
                    buttonStyle: buttonStyle,
                    onClick: async () => {
                        if (await validateCheckout()) return;
                        if (paymentRequestInstance !== request) return;

                        resetPaymentRequest();
                        await renderPaymentRequest();
                    },
                    validate: validateCheckout,
                    createOrder: async () => {
                        const wire = getWireComponent();
                        if (!wire) {
                            throw new Error(methodDisplayName + ' Magewire component is unavailable.');
                        }

                        await wire.call('initializeRevolutOrder');
                        const publicId = wire.get('publicId');
                        if (!publicId) {
                            throw new Error(methodDisplayName + ' order could not be initialized.');
                        }

                        return { publicId: publicId };
                    },
                    onSuccess: async () => {
                        showLoader();
                        markAllStepsComplete();
                        let result = false;
                        let placementError = null;
                        const handlePlacementError = event => {
                            placementError = new Error(event.detail.text);
                        };

                        window.addEventListener(
                            errorEventName,
                            handlePlacementError,
                            { once: true }
                        );

                        try {
                            result = await hyvaCheckout.order.place();
                        } catch (error) {
                            placementError = error;
                        } finally {
                            window.removeEventListener(
                                errorEventName,
                                handlePlacementError
                            );
                        }

                        if (placementError || !result) {
                            try {
                                await recoverFromOrderPlacementFailure(placementError);
                            } catch (recoveryError) {
                                showPlaceOrderButton();
                                hyvaCheckout.payment.dispatchExceptionMessage(
                                    'Unable to reset the payment. Please refresh the page and try again.',
                                    'error'
                                );
                            }
                            hideLoader();
                        }
                    },
                    onError: (error) => {
                        hideLoader();
                        showPlaceOrderButton();
                        hyvaCheckout.payment.dispatchExceptionMessage(
                            error.message || 'An error occurred',
                            'error'
                        );
                    },
                });

                paymentRequestInstance = request;
                return request;
            };

            const renderPaymentRequest = async () => {
                if (!await checkCapability()) return;

                const request = paymentRequestInstance;
                if (!request || !attachPaymentRequestTarget()) return;

                try {
                    await request.render();
                    if (paymentRequestInstance !== request) {
                        return;
                    }

                    hidePlaceOrderButton();
                } catch (error) {
                    if (paymentRequestInstance !== request) return;

                    request.destroy();
                    paymentRequestInstance = null;
                    isAvailable = false;
                    applyAvailability();
                }
            };

            hyvaCheckout.payment.registerMethod({
                code: methodCode,
                method: {
                    initialize: renderPaymentRequest,
                    uninitialize: function () {
                        showPlaceOrderButton();
                        // Keep the capability-checked request so reselecting the method does not create a duplicate.
                        hidePaymentRequestTarget();
                    },
                    validate: async function () {
                        return true;
                    },
                },
            });

            applyAvailability();
            checkCapability();

            if (window.Magewire && typeof Magewire.hook === 'function') {
                Magewire.hook('message.processed', applyAvailability);
            }

            window.addEventListener('payment:method:refresh', async (event) => {
                if (!event.detail || event.detail.method !== methodCode || !paymentRequestInstance) return;

                resetPaymentRequest();
                await renderPaymentRequest();
            });
        });
    })();
