<?php
declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
?>
<script>
    (() => {
        hyvaCheckout.api.after(() => {
            const revolutConfig = <?= $block->getRevolutConfig() ?>;
            const cascadingStepRoutes = <?= $block->getCascadingStepRoutes() ?>;
            let revolutSdk = null;
            let cardInstance = null;
            let upsellInstance = null;
            let placeOrderFallback = null;
            let placeOrderResolve = null;
            let placeOrderReject = null;
            let registeredMethod = null;

            const getWireComponent = () => {
                return Magewire.find('checkout.payment.method.revolut_card');
            };

            // The order is placed from the payment step (the card iframe must stay live), so any later
            // step (e.g. the mobile "summary") is never visited. Mark every step route complete so the
            // server cascade gate (Main::validateCascadingStepData) accepts the order.
            const markAllStepsComplete = () => {
                if (!Array.isArray(cascadingStepRoutes)) return;
                cascadingStepRoutes.forEach((route) => {
                    hyvaCheckout.storage.setValue(route, true, 'cascading-step-data');
                });
            };

            // On multi-step layouts where payment is not the last step, the core footer button navigates
            // forward instead of placing the order. Swap it for a place-order button next to the card so
            // the iframe can be submitted while live. Re-applied after every morph.
            const applyPaymentStepLayout = () => {
                const placeOrderButton = document.getElementById('revolut-card-place-order');
                const navMain = document.querySelector('.checkout-nav-main');
                const placeFromHere = !!cardInstance && hyvaCheckout.navigation.hasNext();

                // Only take over the nav while the card is the active method driving placement; otherwise
                // leave it untouched so other methods (wallets) keep control of the footer button.
                if (!placeFromHere) {
                    if (placeOrderButton) placeOrderButton.style.display = 'none';
                    return;
                }

                if (placeOrderButton) placeOrderButton.style.display = '';
                if (navMain) navMain.style.display = 'none';
            };

            const restoreNavigation = () => {
                const placeOrderButton = document.getElementById('revolut-card-place-order');
                const navMain = document.querySelector('.checkout-nav-main');
                if (placeOrderButton) placeOrderButton.style.display = 'none';
                if (navMain) navMain.style.display = '';
            };

            // Delegated so it survives Magewire morphs replacing the button node.
            document.addEventListener('click', (event) => {
                if (event.target.closest('#revolut-card-place-order')) {
                    event.preventDefault();
                    hyvaCheckout.order.place();
                }
            });

            if (window.Magewire && typeof Magewire.hook === 'function') {
                Magewire.hook('message.processed', applyPaymentStepLayout);
            }

            const loadSdk = () => {
                if (window.RevolutCheckout) {
                    return Promise.resolve(window.RevolutCheckout);
                }
                if (window.revolutCheckoutSdkPromise) {
                    return window.revolutCheckoutSdkPromise;
                }

                window.revolutCheckoutSdkPromise = new Promise((resolve) => {
                    if (!revolutConfig || !revolutConfig.revolutSdk) {
                        resolve(null);
                        return;
                    }

                    const script = document.createElement('script');
                    script.id = 'revolut-checkout-sdk';
                    script.src = revolutConfig.revolutSdk;
                    script.onload = () => resolve(window.RevolutCheckout || null);
                    script.onerror = () => resolve(null);
                    document.head.appendChild(script);
                });

                return window.revolutCheckoutSdkPromise;
            };

            const destroyUpsellInstance = () => {
                if (upsellInstance) {
                    upsellInstance.destroy();
                    upsellInstance = null;
                }
            };

            const loadBannerSdk = () => {
                return new Promise((resolve) => {
                    if (window.RevolutUpsell) {
                        resolve(window.RevolutUpsell);
                        return;
                    }
                    if (!revolutConfig || !revolutConfig.revolutBannerSdk) {
                        resolve(null);
                        return;
                    }
                    const existingScript = document.getElementById('revolut-banner-sdk');
                    if (existingScript) {
                        existingScript.addEventListener('load', () => resolve(window.RevolutUpsell));
                        existingScript.addEventListener('error', () => resolve(null));
                        return;
                    }
                    const script = document.createElement('script');
                    script.id = 'revolut-banner-sdk';
                    script.src = revolutConfig.revolutBannerSdk;
                    script.onload = () => resolve(window.RevolutUpsell);
                    script.onerror = () => resolve(null);
                    document.head.appendChild(script);
                });
            };

            const mountGatewayBanner = async (publicId) => {
                // Always tear down a previously mounted banner so a disabled/empty re-init clears it.
                destroyUpsellInstance();

                const bannersData = revolutConfig.informationalBannersData || {};
                if (!bannersData.isGatewayBannerEnabled || !publicId) {
                    return;
                }

                const targetEl = document.getElementById('revolut-upsell-banner-element');
                if (!targetEl) return;

                const RevolutUpsell = await loadBannerSdk();
                if (!RevolutUpsell) return;

                try {
                    upsellInstance = RevolutUpsell({
                        locale: revolutConfig.locale,
                        publicToken: revolutConfig.publicKey,
                    });

                    upsellInstance.cardGatewayBanner.mount(targetEl, {
                        orderToken: publicId,
                    });
                } catch (e) {
                    console.error('Failed to mount Revolut gateway banner', e);
                    destroyUpsellInstance();
                }
            };

            const showLoader = () => window.dispatchEvent(new Event('magewire:loader:start'));
            const hideLoader = () => window.dispatchEvent(new Event('magewire:loader:done'));

            const recoverFromOrderPlacementFailure = async error => {
                const wire = getWireComponent();
                if (!wire) {
                    throw new Error('Revolut Card Magewire component is unavailable.');
                }

                const message = error && error.message
                    ? error.message
                    : 'Something went wrong while processing your order.';

                await wire.call('cancelRevolutOrder', message);
                await wire.call('initializeRevolutOrder');
                await registeredMethod.uninitialize();
                revolutSdk = null;
                await registeredMethod.initialize();
            };

            registeredMethod = hyvaCheckout.payment.registerMethod({
                code: 'revolut_card',

                method: {
                    initialize: async function () {
                        // Read publicId from the server-rendered DOM rather than the Magewire proxy:
                        // when the card is pre-selected, initialize() fires on the methods-list
                        // component.initialized hook before this method's own component is hydrated, so
                        // its $wire is not yet available.
                        const wrapper = document.getElementById('revolut-card-wrapper');
                        const publicId = wrapper ? wrapper.getAttribute('data-revolut-public-id') : null;
                        if (!publicId) return;

                        const RevolutCheckout = await loadSdk();
                        if (!RevolutCheckout) return;

                        revolutSdk = await RevolutCheckout(publicId);

                        const targetEl = document.getElementById('revolut-card-component');
                        if (targetEl) {
                            if (cardInstance) {
                                cardInstance.destroy();
                                cardInstance = null;
                            }

                            cardInstance = revolutSdk.createCardField({
                                target: targetEl,
                                locale: revolutConfig.locale,
                                hidePostcodeField: revolutConfig.hidePostcodeField,
                                showLoadingIndicator: true,
                                onSuccess: async () => {
                                    if (placeOrderFallback) {
                                        let result = false;
                                        let placementError = null;
                                        const handlePlacementError = event => {
                                            placementError = new Error(event.detail.text);
                                        };

                                        window.addEventListener(
                                            'order:place:revolut_card:error',
                                            handlePlacementError,
                                            { once: true }
                                        );

                                        try {
                                            result = await placeOrderFallback();
                                        } catch (error) {
                                            placementError = error;
                                        } finally {
                                            window.removeEventListener(
                                                'order:place:revolut_card:error',
                                                handlePlacementError
                                            );
                                        }

                                        if (placementError || !result) {
                                            try {
                                                await recoverFromOrderPlacementFailure(placementError);
                                            } catch (recoveryError) {
                                                hyvaCheckout.payment.dispatchExceptionMessage(
                                                    'Unable to reset the payment. Please refresh the page and try again.',
                                                    'error'
                                                );
                                            }

                                            hideLoader();
                                            placeOrderResolve = null;
                                            if (placeOrderReject) {
                                                placeOrderReject(placementError || new Error('Magento order placement failed.'));
                                                placeOrderReject = null;
                                            }
                                        }

                                        placeOrderFallback = null;
                                    }
                                    if (placeOrderResolve) {
                                        placeOrderResolve(true);
                                        placeOrderResolve = null;
                                    }
                                    placeOrderReject = null;
                                },
                                onError: (messages) => {
                                    hyvaCheckout.payment.dispatchExceptionMessage(messages.message || 'Payment error', 'error');
                                    hideLoader();

                                    placeOrderFallback = null;
                                    placeOrderResolve = null;
                                    if (placeOrderReject) {
                                        placeOrderReject(messages.message);
                                        placeOrderReject = null;
                                    }
                                },
                                onValidation: (messages) => {
                                    if (!Array.isArray(messages)) {
                                        return;
                                    }

                                    const errorDiv = document.getElementById('revolut-card-errors');
                                    if (!errorDiv) return;

                                    if (messages.length === 0) {
                                        errorDiv.innerHTML = '';
                                        errorDiv.style.display = 'none';
                                        return;
                                    }

                                    errorDiv.innerHTML = '';
                                    messages.forEach(msg => {
                                        const li = document.createElement('li');
                                        li.innerText = msg;
                                        errorDiv.appendChild(li);
                                    });
                                    errorDiv.style.display = 'block';

                                    placeOrderFallback = null;
                                    placeOrderResolve = null;
                                    if (placeOrderReject) {
                                        hideLoader();
                                        placeOrderReject();
                                        placeOrderReject = null;
                                    }
                                }
                            });
                        }

                        await mountGatewayBanner(publicId);

                        applyPaymentStepLayout();
                    },

                    validate: function() {
                        return true;
                    },

                    uninitialize: async function () {
                        if (cardInstance) {
                            cardInstance.destroy();
                            cardInstance = null;
                        }
                        destroyUpsellInstance();
                        restoreNavigation();
                    },

                    handleException: async function({ exception, fallback }) {
                        await fallback({ exception: exception });
                    },

                    placeOrder: async function({ fallback }) {
                        if (!cardInstance) {
                            hyvaCheckout.payment.dispatchExceptionMessage('The payment widget could not be initialized correctly.', 'error');
                            throw new Error('Card widget not initialized');
                        }

                        const wire = getWireComponent();
                        showLoader();

                        // Placing from the payment step: satisfy the server cascade for any later step.
                        markAllStepsComplete();

                        try {
                            // Sync order totals
                            await wire.call('initializeRevolutOrder');

                            // Sync quote data from server before submission
                            await wire.call('syncQuoteData');

                            const billing = wire.get('billingAddress');
                            const email = wire.get('email');

                            if (!email || !billing) {
                                hyvaCheckout.payment.dispatchExceptionMessage('Please provide your billing and email address.', 'error');
                                throw new Error('Missing billing or email address');
                            }

                            if (!billing.city) {
                                hyvaCheckout.payment.dispatchExceptionMessage('Please provide a city for your billing address.', 'error');
                                throw new Error('Missing billing city');
                            }

                            let name;
                            if (revolutConfig.cardholderNameField) {
                                const cardholderInput = document.getElementById('revolut-card-cardholder-name');
                                name = cardholderInput ? cardholderInput.value.trim() : '';
                            } else {
                                name = `${billing.firstname} ${billing.lastname}`.trim();
                            }

                            placeOrderFallback = fallback;

                            return await new Promise((resolve, reject) => {
                                placeOrderResolve = resolve;
                                placeOrderReject = reject;
                                cardInstance.submit({
                                    email: email,
                                    phone: billing.telephone || '',
                                    name: name,
                                    orderUpdated: true,
                                    billingAddress: {
                                        countryCode: billing.countryCode,
                                        city: billing.city,
                                        streetLine1: billing.streetLine1,
                                        streetLine2: billing.streetLine2,
                                        postcode: billing.postcode
                                    }
                                });
                            });
                        } catch (e) {
                            hideLoader();
                            placeOrderReject = null;
                            placeOrderResolve = null;
                            placeOrderFallback = null;
                            throw e;
                        }
                    },
                }
            });

            window.addEventListener('payment:method:refresh', async (event) => {
                if (!event.detail || event.detail.method !== 'revolut_card' || !cardInstance) return;

                await registeredMethod.uninitialize();
                revolutSdk = null;
                await registeredMethod.initialize();
            });
        });
    })();
</script>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
