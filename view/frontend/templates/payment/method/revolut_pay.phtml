<?php
declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Revolut\PaymentHyva\Magewire\Checkout\Payment\Method\RevolutPay $magewire */
/** @var \Magento\Framework\Escaper $escaper */

$quote = $magewire->getQuote();
$billingAddress = $quote->getBillingAddress();
$shippingAddress = $quote->getShippingAddress();

$email = $quote->getCustomerEmail() ?: ($billingAddress ? $billingAddress->getEmail() : ($shippingAddress ? $shippingAddress->getEmail() : ''));
$firstName = $billingAddress ? $billingAddress->getFirstname() : ($shippingAddress ? $shippingAddress->getFirstname() : '');
$lastName = $billingAddress ? $billingAddress->getLastname() : ($shippingAddress ? $shippingAddress->getLastname() : '');
$name = trim($firstName . ' ' . $lastName);
?>
<div
    data-revolut-email="<?= $escaper->escapeHtmlAttr($email) ?>"
    data-revolut-name="<?= $escaper->escapeHtmlAttr($name) ?>"
    data-revolut-phone="<?= $escaper->escapeHtmlAttr($billingAddress ? $billingAddress->getTelephone() : ($shippingAddress ? $shippingAddress->getTelephone() : '')) ?>"
    data-revolut-currency="<?= $escaper->escapeHtmlAttr($quote->getQuoteCurrencyCode()) ?>"
    data-revolut-amount="<?= $escaper->escapeHtmlAttr($quote->getGrandTotal()) ?>"
>
    <!-- Container for revolut pay UI -->
    <div id="revolut-pay-component" class="mt-4 min-h-[50px]" wire:ignore></div>
    <div id="revolut-pay-errors" class="text-red-600 mt-2 text-sm" style="display: none;"></div>
</div>

